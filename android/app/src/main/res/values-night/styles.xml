<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deliberately the light parents, matching values/styles.xml.

         The app has no dark theme, by choice. Flutter's default night styles
         inherit Theme.Black, so a phone set to dark mode showed a black launch
         window and then a light app — a dark flash before something that was
         never going to be dark. The launch window is the only real Android
         theming here, which is why it was the one place the system setting
         showed at all: Flutter paints its own canvas, so Android's force-dark
         cannot reach the screens themselves. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
